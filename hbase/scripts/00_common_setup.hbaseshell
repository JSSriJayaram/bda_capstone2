# ============================================================
# 00_common_setup.hbaseshell
# COMMON FOUNDATION — ALL STUDENTS MUST DEMONSTRATE THESE
# NYC Yellow Taxi HBase Analytics
# Dataset: NYC TLC Yellow Taxi Trip Data (Jan 2026, 7.6M rows)
# ============================================================
# Run in HBase shell:
#   docker exec -it hbase hbase shell
#   copy-paste commands below
# ============================================================

# -----------------------------------------------------------
# STEP 1: CREATE TABLE with 4 Column Families
# -----------------------------------------------------------
# Row Key format: {VendorID}_{pickup_datetime_compact}_{PULocationID}
# Example: 2_20260101005404_239
# Column Families:
#   trip_info  -> trip metadata (distance, passengers, location)
#   financials -> fare, tip, payment
#   timing     -> pickup/dropoff datetimes, duration
#   metrics    -> computed analytics (speed, fare/mile)

create 'nyc_taxi', 'trip_info', 'financials', 'timing', 'metrics'

# Verify table was created
list
describe 'nyc_taxi'

# -----------------------------------------------------------
# STEP 2: PUT — Insert 12 Real NYC Taxi Records
# -----------------------------------------------------------
