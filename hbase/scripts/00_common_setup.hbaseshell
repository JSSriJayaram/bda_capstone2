# -----------------------------------------------------------
# STEP 3: GET — Point Lookup Operations (COMMON TO ALL)
# -----------------------------------------------------------

# GET 3a: Full row retrieval for a specific trip
get 'nyc_taxi', '2_20260101001931_137'

# GET 3b: Retrieve only one column family (financials)
get 'nyc_taxi', '2_20260101001931_137', {COLUMN => 'financials'}

# GET 3c: Retrieve a single specific column qualifier
get 'nyc_taxi', '1_20260101004153_142', {COLUMN => 'financials:total_amount'}
