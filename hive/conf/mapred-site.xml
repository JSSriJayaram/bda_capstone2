<?xml version="1.0"?>
<configuration>
    <!--
        mapreduce.framework.name=local:
        Hive 3.1.3 bundles Hadoop 3.1.0 (unshaded Protobuf 2.5.0).
        Hadoop 3.3.6 YARN uses shaded Protobuf 3.x.
        Submitting Hive MR jobs to YARN causes:
          ClassCastException: GetFileInfoRequestProto cannot be cast to com.google.protobuf.Message
        Setting local mode lets Hive run MapReduce tasks inside its own JVM,
        reading from and writing to HDFS — without YARN submission.
        YARN is demonstrated independently by the Java MapReduce job (TaxiDriver).
    -->
    <property>
        <name>mapreduce.framework.name</name>
        <value>local</value>
    </property>
</configuration>
